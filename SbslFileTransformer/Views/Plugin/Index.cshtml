@model IEnumerable<Plugin>

@{
    ViewData["Title"] = "Index";
}

<h1>Available Plug-ins</h1>

<table class="table table-bordered table-striped">
    <thead>
        <tr>
            <th>
                Name
            </th>
            <th>
                Description
            </th>
            <th>
                Input Folder
            </th>
            <th>
                Output Folder
            </th>
            <th>
                Check Interval
            </th>
            <th>
                Check Time
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Name)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.InputFolder)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.OutputFolder)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.CheckInterval)
                <td>
                    @Html.DisplayFor(modelItem => item.CheckTime)
                </td>
                <td>
                    @Html.ActionLink("Edit", "Edit", "Plugin", new { id = item.Id }, new { @class = "btn btn-primary" })
                </td>
            </tr>
        }
    </tbody>
</table>
