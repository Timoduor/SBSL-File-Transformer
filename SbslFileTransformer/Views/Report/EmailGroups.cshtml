@model IEnumerable<EmailGroup>

@{
    ViewData["Title"] = "Email Groups";
}


<div class="row">
    <div class="col-md-6">
        <h3>Email Groups</h3>
    </div>
    <div class="col-md-6">
        <a asp-action="CreateGroup" class="btn btn-primary float-right">Create New Group</a>
    </div>
</div>

<hr/>

<table class="table table-striped table-wrapper-scroll-y table-bordered table-sm" style="display: inline-table; overflow: scroll; table-layout: fixed; word-wrap: break-word;">
    <thead>
    <tr>
        <th style="width: 10%">
            Name
        </th>

        <th style="width: 6%">
            Period
        </th>
        <th style="max-width: 23%">
            Emails
        </th>
        <th style="width: 13%">
            Sprint
        </th>
        <th style="width: 9%">
            Country
        </th>
        <th style="width: 15%">
            Comments
        </th>
        <th style="width: 5%">
            Acc
        </th>

        <th style="width: 9%"></th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.GroupName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.AgeAlertDuration)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Emails)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Sprint)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Country)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Description)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Account)
            </td>
            <td>
                @Html.ActionLink("Edit", "EditGroup", "Report", new {id = item.Id}, new {@class = "btn btn-sm btn-info"}) |
                @if (item.IsActive)
                {
                    @Html.ActionLink("Deactivate", "Deactivate", "Report", new {id = item.Id, active = false}, new {@class = "btn btn-sm btn-danger"})
                }
                else
                {
                    @Html.ActionLink("Activate", "Deactivate", "Report", new {id = item.Id, active = true}, new {@class = "btn btn-sm btn-success"})
                }
            </td>
        </tr>
    }
    </tbody>
</table>