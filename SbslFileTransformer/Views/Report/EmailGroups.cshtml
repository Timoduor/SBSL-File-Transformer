@model IEnumerable<SbslFileTransformer.Models.EmailGroup>

@{
    ViewData["Title"] = "Email Groups";
}



<div class="row">
    <div class="col-md-6">
        <h3>Email Groups</h3>
    </div>
    <div class="col-md-6">
        <a asp-action="CreateGroup" class="btn btn-primary float-right">Create New Group</a>
    </div>
</div>

<hr />

<table class="table table-striped table-responsive table-bordered table-sm">
    <thead>
        <tr>
            <th>
                Name
            </th>

            <th>
                Period
            </th>
            <th>
                Account
            </th>
            <th>
                Description
            </th>
            <th>
                Emails
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.GroupName)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.AgeAlertDuration)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Account)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Emails)
                </td>
                <td>
                    @Html.ActionLink("Edit", "EditGroup", "Report", new { id = item.Id }, new { @class = "btn btn-sm btn-info" }) |
                    @if (item.IsActive)
                    {
                        @Html.ActionLink("Deactivate", "Deactivate", "Report", new { id = item.Id, active = false }, new { @class = "btn btn-sm btn-danger" })
                    }
                    else
                    {
                        @Html.ActionLink("Activate", "Deactivate", "Report", new { id = item.Id, active = true }, new { @class = "btn btn-sm btn-success" })
                    }
                </td>
            </tr>
        }
    </tbody>
</table>
