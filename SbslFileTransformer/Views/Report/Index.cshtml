@model SbslFileTransformer.Models.ReportConfigModel

@{
    ViewData["Title"] = "Scheduled Reports";
}


<div class="row">
    <div class="col-md-6">
        <h2>Report Emailing Alerts</h2>
    </div>
    <div class="col-md-3">
        <a class="btn btn-primary float-right" asp-area="" asp-controller="Report" asp-action="EmailGroups">Email Groups</a>
    </div>
    <div class="col-md-3">
        <a class="btn btn-info float-right" asp-area="" asp-controller="Report" asp-action="Processed">Processed Reports</a>
    </div>
</div>


<hr/>

<form asp-action="Index">
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="row">
        <div class="col-md-6">
            <div class="form-group">
                <label asp-for="BaseUrl" class="control-label"></label>
                <input asp-for="BaseUrl" class="form-control"/>
                <span asp-validation-for="BaseUrl" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EnvironmentUrl" class="control-label"></label>
                <input asp-for="EnvironmentUrl" class="form-control"/>
                <span asp-validation-for="EnvironmentUrl" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="UserToken" class="control-label"></label>
                <input asp-for="UserToken" class="form-control"/>
                <span asp-validation-for="UserToken" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Save" class="btn btn-primary"/>
            </div>
        </div>
        <div class="col-md-6">
            <div class="form-group">
                <label asp-for="ExportType" class="control-label"></label>
                <input asp-for="ExportType" class="form-control"/>
                <span asp-validation-for="ExportType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EmailHeader" class="control-label"></label>
                <input asp-for="EmailHeader" class="form-control"/>
                <span asp-validation-for="EmailHeader" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="EmailBody" class="control-label"></label>
                <input asp-for="EmailBody" class="form-control"/>
                <span asp-validation-for="EmailBody" class="text-danger"></span>
            </div>
            <div>
                <a asp-action="Index" asp-controller="Config" class="btn btn-light float-right">Back to List</a>
            </div>
        </div>


    </div>
</form>