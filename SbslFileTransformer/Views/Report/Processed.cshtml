@using X.PagedList.Mvc.Core
@using X.PagedList.Web.Common
@model X.PagedList.IPagedList<ProcessedReport>

@{
    ViewData["Title"] = "Logs";
}
<div class="container">

    @if (!string.IsNullOrEmpty(TempData["Message"]?.ToString()))
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["Message"].ToString()
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <div class="card card-deck small">
        <div class="card-header">
            <strong>Processed Reports</strong>
        </div>
        <div class="card-body">
            <div class="table-wrapper-scroll-y my-custom-scrollbar">
                <table class="table table-striped table-bordered table-sm">
                    <thead class="thead-dark">
                    <tr>
                        <th>
                            Name
                        </th>
                        <th>
                            Date
                        </th>
                        <th>
                            Creator
                        </th>
                        <th>
                            ID
                        </th>
                        <th>
                            Format
                        </th>
                        <th>
                            Notes
                        </th>
                        <th>
                            Message
                        </th>
                        <th>
                            Status
                        </th>
                        <th>
                            EndTime
                        </th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ProcessedDate)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Creator)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ReportId)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Format)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Notes)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Message)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Status)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.EndTime)
                            </td>

                        </tr>
                    }
                    </tbody>
                </table>
                @Html.PagedListPager(Model, page => Url.Action("Processed", new {page}),
                    new PagedListRenderOptions
                    {
                        LiElementClasses = new List<string> {"btn", "btn-light mb-5"}
                    })
            </div>
        </div>
    </div>

</div>