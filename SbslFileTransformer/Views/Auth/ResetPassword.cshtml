@model ResetPasswordViewModel

@{
    Layout = "~/Views/Shared/_LayoutPublic.cshtml";
}



<div class="login-box">
    <div class="login-logo">
        <a href=""><img src="~/img/logo.png" /></a>
    </div>
    <!-- /.login-logo -->
    <div class="card">
        <div class="card-body login-card-body">
            <p class="login-box-msg">Enter new Password</p>
            <span class="text-danger">@TempData["ErrorMessage"]</span>
            @using (Html.BeginForm("ResetPassword", "Auth", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.Email)
                @Html.HiddenFor(m => m.Code)
                <div class="input-group mb-3">
                    @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter new Password", tabindex = "1", autofocus = "true" })
                    <div class="input-group-append">
                        <div class="input-group-text">
                            <span class="fas fa-lock"></span>
                        </div>
                    </div>
                </div>
                @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })
                <div class="input-group mb-3">
                    @Html.PasswordFor(m => m.ConfirmPassword, new { @class = "form-control", placeholder = "Confirm Password", tabindex = "1", autofocus = "true" })
                    <div class="input-group-append">
                        <div class="input-group-text">
                            <span class="fas fa-lock"></span>
                        </div>
                    </div>
                </div>
                @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "text-danger" })
                <div class="row">
                    <div class="col-7">
                    </div>
                    <!-- /.col -->
                    <div class="col-5">
                        <button type="submit" class="btn btn-primary btn-block">Submit </button>
                    </div>
                    <!-- /.col -->
                </div>
            }

        </div>
        <!-- /.login-card-body -->
    </div>
</div>

@section Scripts
{}
