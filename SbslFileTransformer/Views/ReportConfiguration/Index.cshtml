@model List<ReportConfiguration>

@{
    ViewData["Title"] = "Configurations";
}

<h5>Escalation Report Configurations</h5>

<div class="row">
    <div class="col-md-6">
        <div class="row">
            <div class="col-md-6">
                <span class="d-inline-block" tabindex="0" data-toggle="tooltip" title="If ConfigType and Key combination exist then it's value will be UPDATED!">
                    <a asp-action="Create" class="btn btn-primary">Create New Escalation Report</a>
                </span>
            </div>
            <div class="col-md-6">
                <a class="btn btn-info float-right" asp-controller="Report" asp-action="Processed">Processed Reports</a>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <span class="d-inline-block border rounded" tabindex="0" data-toggle="tooltip" title="Download sample file to see the format to use to bulk upload accounts using formatted excel file">

            <b style="margin:10px">Uploads</b>
            <a asp-action="DownloadSample" asp-controller="ReportConfiguration" class="btn btn-primary btn-sm" style="margin:10px">Download Sample File</a>

            <form asp-controller="ReportConfiguration" asp-action="BulkImport" method="post" enctype="multipart/form-data">
                <div class="form-group border rounded" style="margin:10px; padding:5px">
                    <input type="file" name="excel" />
                    <input type="submit" value="Upload and Process File" class="btn btn-success btn-sm" style="margin-right:10px" />
                </div>
            </form>
        </span>
    </div>
</div>
<hr />
<p>

</p>

<div class="card card-light small">
    <div class="card-header">
        <strong>Report Configurations List</strong>
    </div>
    <div class="card-body">
        <div class="table-wrapper-scroll-y my-custom-scrollbar">

            <table class="table table-striped table-responsive table-bordered table-sm" style="width:100%">
                <thead class="thead-dark">
                    <tr>
                        <th style="max-width:5%">
                            ID
                        </th>
                        <th style="max-width:20%">
                            Description
                        </th>
                        <th style="max-width:20%">
                            Name Keywords
                        </th>
                        <th style="max-width:20%">
                            Column Keywords
                        </th>
                        <th style="max-width:5%">
                            Days Overdue
                        </th>
                        <th style="max-width:20%">
                            Recipients
                        </th>
                        <th style="max-width:5%">
                            Details
                        </th>
                        <th style="max-width:5%">
                            Update
                        </th>
                        <th style="max-width:5%">
                            Manager Report
                        </th>
                        <th style="max-width:5%">
                            Enabled
                        </th>
                        <th style="max-width:5%">
                            Remove
                        </th>
                    </tr>
                </thead>
                <tbody>

                    @for (int i = 0; i < Model.Count(); i++)
                    {
                        <tr>
                            <td style="max-width:5%">
                                @Html.DisplayFor(modelItem => Model[i].Id)
                            </td>
                            <td style="word-wrap: break-word;  max-width:200px;">
                                <div style="height: 50px; overflow:auto;">
                                    @Html.DisplayFor(modelItem => Model[i].ReportDescription)
                                </div>
                            </td>
                            <td style="word-wrap: break-word;  max-width:200px;">
                                <div style="height: 50px; overflow:auto;">
                                    @Html.DisplayFor(modelItem => Model[i].NameKeywords)
                                </div>
                            </td>
                            <td style="word-wrap: break-word;  max-width:200px;">
                                <div style="height: 50px; overflow:auto;">
                                    @Html.DisplayFor(modelItem => Model[i].ColumnKeywords)
                                </div>
                            </td>
                            <td style="max-width:5%">
                                @Html.DisplayFor(modelItem => Model[i].DaysOverdue)
                            </td>
                            <td style="word-wrap: break-word;  max-width:200px;">
                                <div style="height: 50px; overflow:auto;">
                                    @Html.DisplayFor(modelItem => Model[i].RecipientEmails)
                                </div>
                            </td>
                            <td style="max-width:5%">
                                <a class="btn btn-primary btn-sm" asp-controller="ReportConfiguration" asp-action="Details" asp-route-id="@Model[i].Id">View</a>
                            </td>
                            <td style="max-width:5%">
                                <a class="btn btn-dark btn-sm" asp-controller="ReportConfiguration" asp-action="Edit" asp-route-id="@Model[i].Id">Edit</a>
                            </td>
                            <td style="max-width:5%">
                                <input type="checkbox" checked="@Model[i].IsManagerReport" data-toggle="modal" data-id="@Model[i].Id" data-target="#managerModal" class="form-control form-control-sm" asp-controller="ReportConfiguration" asp-action="IsManagerReport" asp-route-id="@Model[i].Id" />
                            </td>
                            <td style="max-width:5%">
                                <input type="checkbox" checked="@Model[i].IsEnabled" data-toggle="modal" data-id="@Model[i].Id" data-target="#disableModal" class="form-control form-control-sm" asp-controller="ReportConfiguration" asp-action="Disable" asp-route-id="@Model[i].Id" />
                            </td>
                            <td style="max-width:5%">
                                <button class="btn btn-outline-danger btn-sm" data-toggle="modal" data-target="#deleteModal" data-id="@Model[i].Id">Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>

<div class="modal fade" id="managerModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">New message</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form asp-controller="ReportConfiguration" asp-action="IsManagerReport" method="post" id="updateStateForm">
                    <div class="form-group">
                        <label for="recipient-name" class="col-form-label"></label>
                    </div>
                    <input type="hidden" name="isManagerReport" />
                    <input type="hidden" name="id" />
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="updateState">Update</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="disableModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">New message</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form asp-controller="ReportConfiguration" asp-action="Disable" method="post" id="updateForm">
                    <div class="form-group">
                        <label for="recipient-name" class="col-form-label"></label>
                    </div>
                    <input type="hidden" name="isEnabled" />
                    <input type="hidden" name="id" />
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" id="update">Update</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" role="dialog" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">New message</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form asp-controller="ReportConfiguration" asp-action="Delete" method="post" id="deleteForm">
                    <div class="form-group">
                        <label for="recipient-name" class="col-form-label"></label>
                    </div>
                    <input type="hidden" name="id" />
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" id="delete">Delete</button>
            </div>
        </div>
    </div>
</div>
