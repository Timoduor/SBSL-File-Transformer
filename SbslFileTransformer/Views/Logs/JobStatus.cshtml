@using SbslFileTransformer.Infrastructure.Jobs
@using Humanizer

@model IOrderedEnumerable<KeyValuePair<string, JobStatus>>

@{
    ViewData["Title"] = "Job Status";
}
<partial name="_LogHeader" />
<hr />
<h5>Current Job Statuses</h5>
<hr />

@foreach (var job in Model)
{
    if (job.Value != null && job.Value.Status != SbslFileTransformer.Models.Enums.JobState.Completed)
    {
        string[] background = { "bg-success", "bg-info", "bg-warning", "bg-primary", "bg-danger" };

        int next = new Random().Next(0, 4);

        string classToUse = $"progress-bar progress-bar-striped progress-bar-animated {background[next]}";

        <div>@job.Value.JobName.Humanize()</div>

        <div class="progress" style="background-color:darkgrey">
            <div class="@classToUse" role="progressbar" aria-valuenow="10" aria-valuemin="0" aria-valuemax="100" style="width: @job.Value.PercentageProgress%">
                @job.Value.ProgressMessage, @job.Value.Status.ToString(), @job.Value.PercentageProgress %
            </div>
        </div>
        <br />
    }
}

@if (!Model.Where(j => j.Value != null).Any(j => j.Value.Status != SbslFileTransformer.Models.Enums.JobState.Completed))
{
    <h4>No Jobs Currently in Progress</h4>
}

@section Scripts {

    <script>

        setTimeout("location.reload(true);", 5000);

    </script>

}