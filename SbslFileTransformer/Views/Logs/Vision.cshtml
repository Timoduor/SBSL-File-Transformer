@using X.PagedList.Mvc.Core
@using X.PagedList.Mvc.Core.Common
@model X.PagedList.IPagedList<VisionRecordCollection>

@{
    ViewData["Title"] = "Logs";
}
<div class="container">

    @if (!string.IsNullOrEmpty(TempData["Message"]?.ToString()))
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["Message"].ToString()
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <partial name="_LogHeader"/>

    <div class="card card-light small">
        <div class="card-header">
            <strong>Vision records</strong>
            <strong>Total: @ViewBag.TotalCount</strong>
            <div class="float-right">
                <label>Search:</label>
                <input id="search" placeholder="Type details of Vision record here..." style="width:350px;height:35px" />
            </div>
        </div>
        <div class="card-body">
            <div class="table-wrapper-scroll-y my-custom-scrollbar">
                <table class="table table-striped table-bordered table-sm">
                    <thead class="thead-dark">
                    <tr>
                        <th>
                            Banking Date
                        </th>
                        <th>
                            Trans Details
                        </th>
                        <th>
                            Trans ID
                        </th>
                        <th>
                            Reference No
                        </th>
                        <th>
                            Gl Trans Code
                        </th>
                        <th>
                            Card Number
                        </th>
                        <th>
                            Debit Amount
                        </th>
                        <th>
                            Credit Amount
                        </th>
                        <th>
                            Customer Name
                        </th>
                        <th>
                            Contract Number
                        </th>
                        <th>
                            Account Number
                        </th>
                        <th>
                            Matched
                        </th>
                        <th>
                            FileName
                        </th>
                        <th>
                            Date Extracted
                        </th>
                        <th>
                            Date Matched
                        </th>
                    </tr>
                    </thead>
                    <tbody id="searchReplace">
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="bg-">
                                @Html.DisplayFor(modelItem => item.BankingDate)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TransDetails)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.TransID)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ReferenceNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.GLTransCode)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CardNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DebitAmount)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CreditAmount)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.CustomerName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ContractNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.AccountNumber)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Matched)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.FileName)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.DateExtracted)
                            </td>
                             <td>
                                @Html.DisplayFor(modelItem => item.DateMatched)
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
                @Html.PagedListPager(Model, page => Url.Action("Vision", new {page}),
                    new PagedListRenderOptions
                    {
                        LiElementClasses = new List<string> {"btn", "btn-light mb-5"}
                    })
            </div>
        </div>
    </div>

</div>

@section Scripts
{
    <script>
        $('.alert').alert();

        let timeoutID = null;
        let endpoint = '/Logs/SearchVisionRecordCollection';

        function findVisionRecord(str) {            
            console.log('search: ' + str);
            $.ajax({
                url: endpoint + "?search=" + str,
                contentType: "application/json",
                dataType: 'json',
                success: function(response){
                    console.log('search results are: ');
                    console.log(response);
                    
                    if(response.length > 0 || str.length > 0){

                        var htmlToAppend = '';

                        $.each(response, function(key, value) {

                            htmlToAppend += 
                             '<tr><td>'
                                    + value.bankingDate + 
                                '</td><td>'
                                   + value.transDetails +
                                '</td><td>'
                                    + value.transID +
                                '</td><td>'
                                    + value.referenceNumber +
                                '</td><td>'
                                    + value.glTransCode + 
                                '</td><td>'
                                    + value.cardNumber +
                                '</td><td>'
                                     + value.debitAmount +
                                '</td><td>'
                                     + value.creditAmount +
                                '</td><td>'
                                     + value.customerName +
                                '</td><td>'
                                     + value.contractNumber +
                                '</td><td>'
                                    + value.accountNumber +
                                '</td><td>'
                                    + value.matched +
                                '</td><td>'
                                     + value.fileName +
                                '</td><td>'
                                     + value.dateExtracted +
                                '</td><td>'
                                    + value.dateMatched +
                                '</td><td>';                            
                        }); 

                        $('#searchReplace').html(htmlToAppend);
                    }
                    else{
                        window.location.reload();
                    }
                }
            });
        }

        $('#search').keyup(function(e) {
          clearTimeout(timeoutID);
          const value = e.target.value;
          timeoutID = setTimeout(() => findVisionRecord(value), 1000)
        });
    </script>
}