@model IOrderedEnumerable<Microsoft.Extensions.FileProviders.IFileInfo>

@{
    ViewData["Title"] = "Logs";
}
<div class="container">
    <h6>Logs</h6>

    @if (!string.IsNullOrEmpty(TempData["Message"]?.ToString()))
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["Message"].ToString()
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <partial name="_LogHeader" />

    <br />
    <div class="card card-deck small">
        <div class="card-header">
            <strong>Log Files</strong>
        </div>
        <div class="card-body">
            <div class="table-wrapper-scroll-y my-custom-scrollbar">
                <table class="table table-striped table-bordered table-sm">
                    <thead class="thead-dark">
                        <tr>
                            <th>
                                Name
                            </th>
                            <th>
                                Size(bytes)
                            </th>
                            <th>
                                Last Modified
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Name)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Length)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.LastModified)
                                </td>
                                <td>
                                    @Html.ActionLink("Download", "DownloadLogFile", new { name = item.Name }, new { @class = "btn btn-primary btn-sm", target="_blank" })
                                    @*@Html.ActionLink("Delete", "DeleteLogFile", new { name = item.Name }, new { @class = "btn btn-danger" })*@
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>
