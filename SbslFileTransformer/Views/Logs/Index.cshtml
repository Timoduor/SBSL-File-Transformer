@using X.PagedList.Mvc.Core
@model X.PagedList.IPagedList<SftpUploadedFile>

@{
    ViewData["Title"] = "Logs";
}


@if (!string.IsNullOrEmpty(TempData["Message"]?.ToString()))
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["Message"].ToString()
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<partial name="_LogHeader" />

<div class="card card-light small">
    <div class="card-header">
        <strong>Uploaded Files</strong>
        <strong>Total: @ViewBag.TotalCount</strong>
        <div class="float-right">
            <label><b>Search:</b></label>
            <input id="search" placeholder="Type details of Uploaded File here..." style="width:350px;height:35px" />
        </div>
    </div>
    <div class="card-body">
        <div class="table-wrapper-scroll-y my-custom-scrollbar">
            <table class="table table-striped table-bordered table-sm">
                <thead class="thead-dark">
                    <tr>
                        <th>
                            Name
                        </th>
                        <th>
                            Uploaded Date
                        </th>
                        <th>
                            Size
                        </th>
                        <th>
                            Md5
                        </th>
                        <th>
                            Is Production
                        </th>
                        <th>
                            File Path
                        </th>
                        <th>
                            Converted By
                        </th>
                        <th>
                            Conversion Failed
                        </th>
                        <th>
                            Converted
                        </th>
                        <th>
                            Processed For 62F
                        </th>
                        <th>
                            Balance Extracted
                        </th>
                        <th>
                            Sequence No
                        </th>
                        <th>
                            Statement No
                        </th>
                        <th>
                            Account No
                        </th>

                    </tr>
                </thead>
                <tbody id="searchReplace">
                    @foreach (var item in Model)
                    {
                        <tr class="@(item.IsProduction ? "bg-warning" : "bg-light")">
                            <td class="bg-">
                                @Html.DisplayFor(modelItem => item.Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.UploadedDate)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Size)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Md5)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.IsProduction)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.FilePath)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ConvertedBy)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Failed)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Converted)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.ProcessFor62F)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.BalanceExtracted)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.MtSequenceNo)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.MtStatementNo)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.MtAccountNo)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            @Html.PagedListPager(Model, page => Url.Action("Index", new {page}),
            new PagedListRenderOptions
            {
                LiElementClasses = new List<string> { "btn", "btn-light mb-5" }
            })
        </div>
    </div>
</div>



@section Scripts
{
    <script>
        $('.alert').alert();

        let timeoutID = null;
        let endpoint = '/Logs/SearchUploadedFile';

        function findUploadedFile(str) {
            console.log('search: ' + str);
            $.ajax({
                url: endpoint + "?search=" + str,
                contentType: "application/json",
                dataType: 'json',
                success: function(response){
                    console.log('search results are: ');
                    console.log(response);

                    if(response.length > 0 || str.length > 0){

                        var htmlToAppend = '';

                        $.each(response, function(key, value) {

                            htmlToAppend +=
                             '<tr><td>'
                                    + value.name +
                                '</td><td>'
                                   + value.uploadedDate +
                                '</td><td>'
                                    + value.size +
                                '</td><td>'
                                    + value.md5 +
                                '</td><td>'
                                    + value.isProduction +
                                '</td><td>'
                                    + value.filePath +
                                '</td><td>'
                                     + value.convertedBy +
                                '</td><td>'
                                     + value.failed +
                                '</td><td>'
                                     + value.converted +
                                '</td><td>'
                                     + value.processFor62F +
                                '</td><td>'
                                    + value.balanceExtracted +
                                '</td><td>'
                                     + value.mtSequenceNo +
                                '</td><td>'
                                     + value.mtStatementNo +
                                '</td><td>'
                                     + value.mtAccountNo +
                                '</td></tr>';
                        });

                        $('#searchReplace').html(htmlToAppend);
                    }
                    else{
                        window.location.reload();
                    }
                }
            });
        }

        $('#search').keyup(function(e) {
          clearTimeout(timeoutID);
          const value = e.target.value;
          timeoutID = setTimeout(() => findUploadedFile(value), 1000)
        });
    </script>
}