@model LogInfo

@{
    ViewData["Title"] = "Logs";
}
<div class="container">
    <h2>Logs</h2>

    @if (!string.IsNullOrEmpty(TempData["Message"]?.ToString()))
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["Message"].ToString()
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }
    <div class="card card-light">
        <div class="card-header">
            <strong>Uploaded Files</strong>
        </div>
        <div class="card-body">
            <div class="table-wrapper-scroll-y my-custom-scrollbar">
                <table class="table table-striped table-bordered table-sm small">
                    <thead class="thead-dark">
                        <tr>
                            <th>
                                Name
                            </th>
                            <th>
                                Uploaded Date
                            </th>
                            <th>
                                Size
                            </th>
                            <th>
                                Md5
                            </th>
                            <th>
                                Is Production
                            </th>
                            <th>
                                File Path
                            </th>
                            <th>
                                Sequence No
                            </th>
                            <th>
                                Statement No
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.UploadedFiles)
                        {
                        <tr class="@(item.IsProduction ? "bg-warning": "bg-light")">
                            <td class="bg-">
                                @Html.DisplayFor(modelItem => item.Name)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.UploadedDate)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Size)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Md5)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.IsProduction)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.FilePath)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.MtSequenceNo)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.MtStatementNo)
                            </td>
                        </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <br />
    <div class="card card-light">
        <div class="card-header">
            <strong>Log Entries</strong>
        </div>
        <div class="card-body">
            <div class="table-wrapper-scroll-y my-custom-scrollbar">
                <table class="table table-striped table-bordered table-sm small">
                    <thead class="thead-dark">
                        <tr>
                            <th>
                                Time Stamp
                            </th>
                            <th>
                                Level
                            </th>
                            <th>
                                Rendered Message
                            </th>
                            <th>
                                Properties
                            </th>
                            <th>
                                Exception
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.SqliteLogs)
                        {
                            <tr class="@(item.Level == "Error" ? "bg-danger": item.Level == "Warning" ? "bg-warning" : "")">
                                <td>
                                    @Html.DisplayFor(modelItem => item.TimeStamp)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Level)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.RenderedMessage)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Properties)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Exception)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
    <br />
    <div class="card card-deck">
        <div class="card-header">
            <strong>Log Files</strong>
        </div>
        <div class="card-body">
            <div class="table-wrapper-scroll-y my-custom-scrollbar">
                <table class="table table-striped table-bordered table-sm small">
                    <thead class="thead-dark">
                        <tr>
                            <th>
                                Name
                            </th>
                            <th>
                                Size(bytes)
                            </th>
                            <th>
                                Last Modified
                            </th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.FileInfos)
                        {
                            <tr>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Name)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Length)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.LastModified)
                                </td>
                                <td>
                                    @Html.ActionLink("Download", "DownloadLogFile", new { name = item.Name }, new { @class = "btn btn-primary btn-sm" })
                                    @*@Html.ActionLink("Delete", "DeleteLogFile", new { name = item.Name }, new { @class = "btn btn-danger" })*@
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts
{
    <script>
        $('.alert').alert();
    </script>
}
