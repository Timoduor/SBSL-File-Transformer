@model IOrderedEnumerable<SbslFileTransformer.Models.SqliteLog>

@{
    ViewData["Title"] = "Logs";
}
<div class="container">
    <h6>Logs</h6>

    @if (!string.IsNullOrEmpty(TempData["Message"]?.ToString()))
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["Message"].ToString()
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <partial name="_LogHeader" />

    <div class="card card-light small">
        <div class="card-header">
            <strong>Log Entries</strong>
        </div>
        <div class="card-body">
            <div class="table-wrapper-scroll-y my-custom-scrollbar">
                <table class="table table-striped table-bordered table-sm small">
                    <thead class="thead-dark">
                        <tr>
                            <th>
                                Time Stamp
                            </th>
                            <th>
                                Level
                            </th>
                            <th>
                                Rendered Message
                            </th>
                            <th>
                                Properties
                            </th>
                            <th>
                                Exception
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr class="@(item.Level == "Error" ? "bg-danger": item.Level == "Warning" ? "bg-warning" : "")">
                                <td>
                                    @Html.DisplayFor(modelItem => item.TimeStamp)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Level)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.RenderedMessage)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Properties)
                                </td>
                                <td>
                                    @Html.DisplayFor(modelItem => item.Exception)
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
