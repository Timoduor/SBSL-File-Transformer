@using X.PagedList.Mvc.Core
@model X.PagedList.IPagedList<LogEntries>

@{
    ViewData["Title"] = "Logs";
}


@if (!string.IsNullOrEmpty(TempData["Message"]?.ToString()))
{
    <div class="alert alert-warning alert-dismissible fade show" role="alert">
        @TempData["Message"].ToString()
        <button type="button" class="close" data-dismiss="alert" aria-label="Close">
            <span aria-hidden="true">&times;</span>
        </button>
    </div>
}

<partial name="_LogHeader" />

<div class="card card-light small">
    <div class="card-header">
        <div class="row">
            <div class="col-md-6">
                <p>
                    <strong>Total Log Entries: @ViewBag.TotalCount</strong>
                </p>
                <p>
                    <strong>Selected Log Level: @ViewBag.SelectedLevel</strong>
                </p>
            </div>
            <div class="col-md-6">
                <form asp-controller="Logs" asp-action="Entries">
                    <div class="form-group">
                        <label class="control-label"></label>
                        <select asp-items="@ViewBag.LogLevels" class="custom-select-lg input-lg" name="level">
                            <option>Please select one</option>
                        </select>
                        <button type="submit" class="btn-lg">Load</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
    <div class="card-body">
        <div class="table-wrapper-scroll-y my-custom-scrollbar">
            <table class="table table-striped table-bordered table-sm">
                <thead class="thead-dark">
                    <tr>
                        <th>
                            Time Stamp
                        </th>
                        <th>
                            Level
                        </th>
                        <th>
                            Rendered Message
                        </th>
                        <th>
                            Properties
                        </th>
                        <th>
                            Exception
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr class="@(item.Level == "Error" ? "bg-danger" : item.Level == "Warning" ? "bg-warning" : "")">
                            <td>
                                @Html.DisplayFor(modelItem => item.TimeStamp)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Level)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.RenderedMessage)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Properties)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Exception)
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
        @Html.PagedListPager(Model, page => Url.Action("Entries", new {page, level = ViewBag.SelectedLevel}),
        new PagedListRenderOptions
        {
            LiElementClasses = new List<string> { "btn", "btn-light mb-5" }
        })
    </div>

</div>
