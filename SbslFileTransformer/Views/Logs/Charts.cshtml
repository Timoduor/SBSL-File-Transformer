@using Newtonsoft.Json
@model SbslFileTransformer.Models.ViewModels.ChartObjects

<div class="container">

    @if (!string.IsNullOrEmpty(TempData["Message"]?.ToString()))
    {
        <div class="alert alert-warning alert-dismissible fade show" role="alert">
            @TempData["Message"].ToString()
            <button type="button" class="close" data-dismiss="alert" aria-label="Close">
                <span aria-hidden="true">&times;</span>
            </button>
        </div>
    }

    <partial name="_LogHeader"/>

    <div class="card card-deck small">
        <div class="card-header">
            <strong>Charts</strong>
        </div>
        <div class="card-body">

            <h3>Files Per Day</h3>
            <div>
                <canvas id="myFilesPerDay" width="500" height="200"></canvas>
            </div>
            <br/><br/>

            <h3>Files Per Month</h3>
            <div>
                <canvas id="myFilesPerMonth" width="500" height="200"></canvas>
            </div>
            <br/><br/>

            <h3>Logs Per Day</h3>
            <div>
                <canvas id="myLogs" width="500" height="200"></canvas>
            </div>
            <br/><br/>

            <h3>Reports Per Day</h3>
            <div>
                <canvas id="myReports" width="500" height="200"></canvas>
            </div>

        </div>
    </div>
</div>

@section Scripts{
    <script>

        //FILES PER DAY

        var ctx = document.getElementById('myFilesPerDay');

        var labels = @Html.Raw(JsonConvert.SerializeObject(Model.UploadedFilesPerDay.Keys));
        var data = @Html.Raw(JsonConvert.SerializeObject(Model.UploadedFilesPerDay.Values));

        var myChart = new Chart(ctx,
            {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Files Uploaded Per day (Last 14 days)',
                            data: data,
                            backgroundColor: [
                                'rgba(255, 99, 132, 0.2)',
                                'rgba(54, 162, 235, 0.2)',
                                'rgba(255, 206, 86, 0.2)',
                                'rgba(75, 192, 192, 0.2)',
                                'rgba(153, 102, 255, 0.2)',
                                'rgba(153, 102, 115, 0.2)',
                                'rgba(255, 159, 64, 0.2)'
                            ],
                            borderColor: [
                                'rgba(255, 99, 132, 1)',
                                'rgba(54, 162, 235, 1)',
                                'rgba(255, 206, 86, 1)',
                                'rgba(75, 192, 192, 1)',
                                'rgba(153, 102, 255, 1)',
                                'rgba(229, 102, 215, 1)',
                                'rgba(255, 159, 64, 1)'
                            ],
                            borderWidth: 1
                        }
                    ]
                },
                options: {
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });

            //FILES PER MONTH

        var ctx = document.getElementById('myFilesPerMonth');

        var labels = @Html.Raw(JsonConvert.SerializeObject(Model.UploadedFilesPerMonth.Keys));
        var data = @Html.Raw(JsonConvert.SerializeObject(Model.UploadedFilesPerMonth.Values));

        var myChart = new Chart(ctx,
            {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Files Uploaded Per Month (Last 7 months)',
                            data: data,
                            backgroundColor: [
                                'rgba(255, 99, 132, 0.2)',
                                'rgba(54, 162, 235, 0.2)',
                                'rgba(255, 206, 86, 0.2)',
                                'rgba(75, 192, 192, 0.2)',
                                'rgba(153, 102, 255, 0.2)',
                                'rgba(153, 102, 115, 0.2)',
                                'rgba(255, 159, 64, 0.2)'
                            ],
                            borderColor: [
                                'rgba(255, 99, 132, 1)',
                                'rgba(54, 162, 235, 1)',
                                'rgba(255, 206, 86, 1)',
                                'rgba(75, 192, 192, 1)',
                                'rgba(153, 102, 255, 1)',
                                'rgba(229, 102, 215, 1)',
                                'rgba(255, 159, 64, 1)'
                            ],
                            borderWidth: 1
                        }
                    ]
                },
                options: {
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });


        //LOGS

        var ctx2 = document.getElementById('myLogs');

        var labels = @Html.Raw(JsonConvert.SerializeObject(Model.Logs.Keys));
        var data = @Html.Raw(JsonConvert.SerializeObject(Model.Logs.Values));

        var myChart = new Chart(ctx2,
            {
                type: 'line',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Logs Per day',
                            data: data,
                            backgroundColor: [
                                'rgba(255, 99, 132, 0.2)',
                                'rgba(54, 162, 235, 0.2)',
                                'rgba(255, 206, 86, 0.2)',
                                'rgba(75, 192, 192, 0.2)',
                                'rgba(153, 102, 255, 0.2)',
                                'rgba(153, 102, 115, 0.2)',
                                'rgba(255, 159, 64, 0.2)'
                            ],
                            borderColor: [
                                'rgba(255, 99, 132, 1)',
                                'rgba(54, 162, 235, 1)',
                                'rgba(255, 206, 86, 1)',
                                'rgba(75, 192, 192, 1)',
                                'rgba(153, 102, 255, 1)',
                                'rgba(229, 102, 215, 1)',
                                'rgba(255, 159, 64, 1)'
                            ],
                            borderWidth: 1
                        }
                    ]
                },
                options: {
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });


        //REPORTS

        var ctx3 = document.getElementById('myReports');

        var labels = @Html.Raw(JsonConvert.SerializeObject(Model.Reports.Keys));
        var data = @Html.Raw(JsonConvert.SerializeObject(Model.Reports.Values));

        var myChart = new Chart(ctx3,
            {
                type: 'pie',
                data: {
                    labels: labels,
                    datasets: [
                        {
                            label: 'Reports Per day',
                            data: data,
                            backgroundColor: [
                                'rgba(255, 99, 132, 0.2)',
                                'rgba(54, 162, 235, 0.2)',
                                'rgba(255, 206, 86, 0.2)',
                                'rgba(75, 192, 192, 0.2)',
                                'rgba(153, 102, 255, 0.2)',
                                'rgba(153, 102, 115, 0.2)',
                                'rgba(255, 159, 64, 0.2)'
                            ],
                            borderColor: [
                                'rgba(255, 99, 132, 1)',
                                'rgba(54, 162, 235, 1)',
                                'rgba(255, 206, 86, 1)',
                                'rgba(75, 192, 192, 1)',
                                'rgba(153, 102, 255, 1)',
                                'rgba(229, 102, 215, 1)',
                                'rgba(255, 159, 64, 1)'
                            ],
                            borderWidth: 1
                        }
                    ]
                },
                options: {
                    scales: {
                        y: {
                            beginAtZero: true
                        }
                    }
                }
            });

    </script>
}