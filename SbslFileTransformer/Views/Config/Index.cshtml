@model IEnumerable<SbslFileTransformer.Models.Configuration>

@{
    ViewData["Title"] = "Configurations";
}

<h1>Configurations</h1>
<div class="row">
    <div class="col-md-12">
        <form asp-action="RestartService">
            <div class="form-group">
                <label class="control-label">Service Name:</label>
                <input class="form-control" type="text" value="@ViewBag.ServiceName" name="serviceName" />
            </div>
            <div class="form-group">
                <button type="submit" class="btn btn-warning" >Restart Service</button>
            </div>

        </form>
    </div>
</div>
<hr />
<p>
    <span class="d-inline-block" tabindex="0" data-toggle="tooltip" title="If ConfigType and Key combination exist then it's value will be UPDATED!">
        <a asp-action="Create" class="btn btn-primary">Create or Update</a>
    </span>
</p>
<table class="table table-striped table-responsive table-bordered table-sm">
    <thead class="thead-dark">
        <tr>
            <th>
                Config Type
            </th>
            <th>
                Key
            </th>
            <th>
                Value
            </th>
            <th>
                Last Updated
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.ConfigType)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Key)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Value)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.Updated)
                </td>
                <td>
                    <a class="btn btn-primary btn-sm" asp-controller="Config" asp-action="Update" asp-route-key="@item.Key" asp-route-configType="@((int)item.ConfigType)" >Edit</a>
                </td>
            </tr>
        }
    </tbody>
</table>
