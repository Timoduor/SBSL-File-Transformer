@model IEnumerable<SbslFileTransformer.Models.Configuration>

@{
    ViewData["Title"] = "Configurations";
}

<h1>Configurations</h1>

<p>
    <span class="d-inline-block" tabindex="0" data-toggle="tooltip" title="If ConfigType and Key combination exist then it's value will be UPDATED!">
        <a asp-action="Create" class="btn btn-primary">Create or Update</a>
    </span>
</p>
<table class="table table-striped table-bordered table-sm">
    <thead class="thead-dark">
        <tr>
            <th>
                Config Type
            </th>
            <th>
                Key
            </th>
            <th>
                Value
            </th>
            <th>
                Last Updated
            </th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.ConfigType)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Key)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Value)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Updated)
            </td>
        </tr>
}
    </tbody>
</table>
