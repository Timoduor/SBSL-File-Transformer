@model List<Configuration>

@{
    ViewData["Title"] = "Configurations";
}

<h1>Configurations</h1>
<div class="row">
    <div class="col-md-12">
        <form asp-action="RestartService">
            <div class="row">
                <div class="col-md-4">
                    <label class="control-label">Service Name:</label>
                </div>
                <div class="col-md-4">
                    <input class="form-control" type="text" value="@ViewBag.ServiceName" name="serviceName" />
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-warning">Restart Service</button>
                </div>
            </div>
        </form>
    </div>
</div>
<hr />
<p>
    <span class="d-inline-block" tabindex="0" data-toggle="tooltip" title="If ConfigType and Key combination exist then it's value will be UPDATED!">
        <a asp-action="Create" class="btn btn-primary">Create New</a>
    </span>
</p>

<div class="card card-light small">
    <div class="card-header">
        <strong>Configurations/Settings</strong>
    </div>
    <div class="card-body">
        <div class="table-wrapper-scroll-y my-custom-scrollbar">

            <table class="table table-striped table-responsive table-bordered table-sm">
                <thead class="thead-dark">
                    <tr>
                        <th>
                            Config Type
                        </th>
                        <th>
                            Key
                        </th>
                        <th>
                            Value
                        </th>
                        <th>
                            Last Updated
                        </th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    <tr><td><b>@Model[0].ConfigType.ToString().ToUpper()</b></td></tr>
                    <tr><td><hr/></td></tr>
                    @for (int i = 0; i < Model.Count(); i++)
                    {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => Model[i].ConfigType)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => Model[i].Key)
                            </td>
                            <td style="word-wrap: break-word; max-width: 550px">
                                @Html.DisplayFor(modelItem => Model[i].Value)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => Model[i].Updated)
                            </td>
                            <td>
                                <a class="btn btn-primary btn-sm" asp-controller="Config" asp-action="Update" asp-route-key="@Model[i].Key" asp-route-configType="@((int) Model[i].ConfigType)">Edit</a>
                            </td>
                        </tr>
                        if((i + 1) < Model.Count() && Model[i+1].ConfigType != Model[i].ConfigType)
                        {
                            <tr><td><hr/></td></tr>
                            <tr><td><b>@Model[i+1].ConfigType.ToString().ToUpper()</b></td></tr>
                        }
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>