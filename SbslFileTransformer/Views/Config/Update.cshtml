@model SbslFileTransformer.Models.Configuration

@{
    ViewData["Title"] = "Update";
}

<h1>Create</h1>

<h4>Configuration</h4>
<hr />
<div class="row">
    <div class="col-md-4">
        <form asp-action="Create" id="configUpdate">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="form-group">
                <label asp-for="ConfigType" class="control-label"></label>
                <select asp-for="ConfigType" asp-items="@ViewBag.ConfigTypes"><option>Please select one</option></select>
                <span asp-validation-for="ConfigType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Key" class="control-label"></label>
                <input asp-for="Key" class="form-control" value="@Model.Key" />
                <span asp-validation-for="Key" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Value" class="control-label"></label>
                <textarea asp-for="Value" rows="5" cols="45" form="configUpdate"></textarea>
                <span asp-validation-for="Value" class="text-danger"></span>
            </div>
            <div class="form-group">
                <input type="submit" value="Update" class="btn btn-primary" />
            </div>
        </form>


    </div>
</div>

<div>
    <a asp-action="Index" class="btn btn-light float-right">Back to List</a>
</div>

