<mah:MetroWindow
    x:Class="SbslServiceManager.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SbslServiceManager"
    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="SBSL ETL Service Manager"
    Width="800"
    Height="450"
    Closed="MetroWindow_Closed"
    Closing="MetroWindow_Closing"
    Icon="sbsl.ico"
    ResizeMode="NoResize"
    Visibility="Hidden"
    WindowStartupLocation="CenterScreen"
    mc:Ignorable="d">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition />
            <RowDefinition />
        </Grid.RowDefinitions>
        <local:CustomTaskBarIcon x:Name="SbslTaskBarIcon" />
        <!--  add other controls for the main window like uploading updates  -->
        <StackPanel Margin="20,10" Orientation="Horizontal">
            <Border
                Margin="10,0"
                BorderBrush="Gray"
                BorderThickness="2"
                CornerRadius="4">
                <StackPanel Orientation="Horizontal">
                    <Canvas Margin="5,5">
                        <Ellipse
                            x:Name="ServiceStatusColour"
                            Width="20"
                            Height="20"
                            Fill="Green" />
                    </Canvas>
                    <TextBlock
                        x:Name="ServiceStatusText"
                        Grid.Column="1"
                        MaxWidth="150"
                        Margin="30,5"
                        TextWrapping="Wrap">
                        Running
                    </TextBlock>
                </StackPanel>
            </Border>
            <Border
                BorderBrush="Gray"
                BorderThickness="2"
                CornerRadius="4">
                <StackPanel Orientation="Horizontal">
                    <Canvas Margin="5,5">
                        <Ellipse
                            x:Name="MariaDBStatusColour"
                            Width="20"
                            Height="20"
                            Fill="Green" />
                    </Canvas>
                    <TextBlock
                        x:Name="MariaDBStatusText"
                        Grid.Column="1"
                        Margin="30,5">
                        Running
                    </TextBlock>
                </StackPanel>
            </Border>
            <Button
                Height="50"
                Margin="10,0"
                Click="RestartService_Click"
                ToolTip="click here to restart the SBSL ETL Service">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Refresh_48px.png" />
                        <Label Content="Restart Service" FontSize="15" />
                    </StackPanel>
                </Button.Content>
            </Button>
            <Button
                Height="50"
                Margin="10,0"
                Click="OpenWebApp_Click"
                ToolTip="click open the Web App">
                <Button.Content>
                    <StackPanel Orientation="Horizontal">
                        <Image Source="Chrome_48px.png" />
                        <Label Content="Open Web App" FontSize="15" />
                    </StackPanel>
                </Button.Content>
            </Button>
        </StackPanel>

        <StackPanel
            Grid.Row="1"
            Margin="10,10"
            Orientation="Vertical">
            <StackPanel Orientation="Horizontal">
                <Label VerticalAlignment="Center">Select Upgrade Zip File:</Label>
                <TextBox
                    x:Name="FilePath"
                    Width="300"
                    Margin="10,0"
                    VerticalAlignment="Center" />
                <Button
                    Height="50"
                    Margin="10,0"
                    Click="SelectFiles_Click"
                    ToolTip="Click to select upgrade zip file from folder system">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="Select_48px.png" />
                            <Label Content="Select Files" FontSize="14" />
                        </StackPanel>
                    </Button.Content>
                </Button>
                <Button
                    x:Name="StartUpgrade"
                    Height="50"
                    Click="StartUpgrade_Click"
                    ToolTip="Click to start upgrade process">
                    <Button.Content>
                        <StackPanel Orientation="Horizontal">
                            <Image Source="Play_48px.png" />
                            <Label Content="Start Upgrade" FontSize="14" />
                        </StackPanel>
                    </Button.Content>
                </Button>
            </StackPanel>
            <mah:MetroProgressBar
                x:Name="UpgradeProgress"
                Margin="10,20"
                Maximum="1" />
            <Label
                x:Name="ProgressMessage"
                Margin="0,10"
                HorizontalAlignment="Center"
                Foreground="DarkBlue" />
        </StackPanel>

    </Grid>
</mah:MetroWindow>
