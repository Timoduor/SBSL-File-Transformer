<UserControl
    x:Class="SbslServiceManager.CustomTaskBarIcon"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:SbslServiceManager"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:tb="http://www.hardcodet.net/taskbar"
    d:DesignHeight="450"
    d:DesignWidth="800"
    mc:Ignorable="d">
    <Grid>
        <tb:TaskbarIcon
            Name="taskBarNotify"
            IconSource="sbsl.ico"
            ToolTipText="SBSL ETL Service">

            <tb:TaskbarIcon.TrayToolTip>
                <Border
                    Width="300"
                    Height="40"
                    Background="White"
                    BorderBrush="LightBlue"
                    BorderThickness="2"
                    CornerRadius="4"
                    Opacity="0.8">
                    <StackPanel Orientation="Horizontal">
                        <Image Source="sbsl.jpg" />
                        <TextBlock
                            Margin="10,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Text="SBSL ETL Service Manager" />
                    </StackPanel>

                </Border>
            </tb:TaskbarIcon.TrayToolTip>

            <tb:TaskbarIcon.TrayPopup>
                <Border
                    Width="160"
                    Height="100"
                    Background="White"
                    BorderBrush="Orange"
                    BorderThickness="2"
                    CornerRadius="4">
                    <StackPanel Orientation="Vertical">
                        <Label FontStyle="Oblique" FontWeight="Bold">SBSL ETL Service Status</Label>
                        <StackPanel Orientation="Horizontal">
                            <Canvas Margin="5,5">
                                <Ellipse
                                    x:Name="ServiceStatusColour"
                                    Width="20"
                                    Height="20"
                                    Fill="Green" />
                            </Canvas>
                            <TextBlock
                                x:Name="ServiceStatusText"
                                Grid.Column="1"
                                Margin="30,5">
                                Running
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Canvas Margin="5,5">
                                <Ellipse
                                    x:Name="MariaDBStatusColour"
                                    Width="20"
                                    Height="20"
                                    Fill="Green" />
                            </Canvas>
                            <TextBlock
                                x:Name="MariaDBStatusText"
                                Grid.Column="1"
                                Margin="30,5">
                                Running
                            </TextBlock>
                        </StackPanel>
                    </StackPanel>

                </Border>
            </tb:TaskbarIcon.TrayPopup>

            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Background="LightGreen">
                    <MenuItem
                        Height="50"
                        Click="RestartService_Click"
                        Header="Restart Server Manager">
                        <MenuItem.Icon>
                            <Image Source="Refresh_48px.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Height="50"
                        Click="OpenWebApp_Click"
                        Header="Open Web App">
                        <MenuItem.Icon>
                            <Image Source="Chrome_48px.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Height="50"
                        Click="ShowMainWindow_Click"
                        Header="Show Main Window">
                        <MenuItem.Icon>
                            <Image Source="sbsl.ico" />
                        </MenuItem.Icon>
                    </MenuItem>
                    <MenuItem
                        Height="50"
                        Click="ExitManager_Click"
                        Header="Exit Manager">
                        <MenuItem.Icon>
                            <Image Source="Shutdown_48px.png" />
                        </MenuItem.Icon>
                    </MenuItem>
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>

        </tb:TaskbarIcon>
    </Grid>
</UserControl>
